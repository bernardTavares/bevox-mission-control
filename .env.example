# Cloudflare Access — comma-separated allowlist of authorized emails.
# Mission Control trusts the Cf-Access-Authenticated-User-Email header
# injected by Cloudflare at the edge. The app has no local login.
MC_ACCESS_ALLOWLIST=you@example.com

# OpenClaw paths — required to override the upstream TenacitOS fallback.
# Upstream fork hardcodes /root/.openclaw (container-as-root assumption).
# On any non-container host, these MUST be set to the real paths or
# 27+ API routes under src/app/api/ will 500 with permission errors.
OPENCLAW_DIR=/home/you/.openclaw
OPENCLAW_WORKSPACE=/home/you/.openclaw/workspace

# E2 canonical agents projection — path to the bevox-knowledge clone.
# Required in production; dev falls back to $HOME/bevox-knowledge.
# GET /api/agents/canonical returns 503 canonical_not_configured if unset in prod.
BEVOX_KNOWLEDGE_DIR=/home/you/bevox-knowledge

# E5 wave 1 — Delivery operator state projection.
# Required in production; in dev, falls back to $HOME/.openclaw/delivery/state.json.
# GET /api/delivery/state returns 503 if unset in production.
# DELIVERY_STATE_PATH=/home/you/.openclaw/delivery/state.json

# Branding (Bevox v1 — neutral palette + tipographic logo).
# All values reversible without code changes; full Bevox identity deferred
# per spec 35_specs/2026-04-10-e2-mission-control.md §3.4.
# Values with spaces are double-quoted so this file can be `source`d from
# bash for operational scripts; systemd EnvironmentFile strips the quotes
# when loading.
NEXT_PUBLIC_APP_TITLE="Bevox Mission Control"
NEXT_PUBLIC_AGENT_NAME="Bevox Mission Control"
NEXT_PUBLIC_AGENT_EMOJI=🦞
NEXT_PUBLIC_AGENT_DESCRIPTION="Bevox Company OS — Mission Control"
NEXT_PUBLIC_AGENT_LOCATION=
NEXT_PUBLIC_BIRTH_DATE=
NEXT_PUBLIC_AGENT_AVATAR=
NEXT_PUBLIC_OWNER_USERNAME=bernard
NEXT_PUBLIC_OWNER_EMAIL=you@example.com
NEXT_PUBLIC_OWNER_COLLAB_EMAIL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_COMPANY_NAME=BEVOX

# E8 wave 1 — Health operational snapshot
HEALTH_STATE_PATH=/home/you/.openclaw/health/state.json

# E9 wave 1 — Cost & usage collector DB path
# Required in production; in dev, falls back to $HOME/.openclaw/cost/usage-tracking.db
# GET /api/costs returns 503 cost_not_configured if unset in production.
USAGE_DB_PATH=/home/you/.openclaw/cost/usage-tracking.db

# E11 wave 1 — Finance runway snapshot path
# Required in production; in dev, falls back to $HOME/.openclaw/finance/state.json
# GET /api/finance/state returns 503 finance_not_configured if unset in production.
FINANCE_STATE_PATH=/home/you/.openclaw/finance/state.json

# E9 wave 2 — Cost alerts state path
# Required in production; in dev, falls back to $HOME/.openclaw/cost/cost-alerts-state.json
# GET /api/cost-alerts/state returns 503 cost_alerts_not_configured if unset in production.
COST_ALERTS_STATE_PATH=/home/you/.openclaw/cost/cost-alerts-state.json
